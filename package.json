{
  "name": "mcp-server-app-store-connect",
  "version": "2.0.0",
  "description": "MCP server covering the App Store Connect API: listings, localizations, screenshots, review submission, pricing, in-app purchases, reviews and code signing",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-server-app-store-connect": "dist/index.js"
  },
  "author": "Abdoul Tapsoba",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prodevking1/mcp-server-app-store-connect.git"
  },
  "homepage": "https://github.com/Prodevking1/mcp-server-app-store-connect#readme",
  "bugs": {
    "url": "https://github.com/Prodevking1/mcp-server-app-store-connect/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "apple",
    "app-store-connect",
    "ios",
    "app-store",
    "testflight",
    "screenshots",
    "localization"
  ],
  "files": [
    "dist",
    "README.md",
