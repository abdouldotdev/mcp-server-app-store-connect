# ---------------------------------------------------------------------------
# Apple App Store Connect API credentials (required)
# ---------------------------------------------------------------------------
APPLE_KEY_ID=your_key_id_here
APPLE_ISSUER_ID=your_issuer_id_here

# Required at startup, but no tool reads it: every tool takes an appId argument,
# so this is only a default marker for the account you work with.
APPLE_BUNDLE_ID=com.yourcompany.yourapp

# Private key (.p8 contents). Raw PEM or base64-encoded, both are accepted.
# Keep this secret: it grants full API access to your App Store Connect account.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
your_private_key_content_here
-----END PRIVATE KEY-----"

# Vendor number for sales/finance reports. Falls back to APPLE_ISSUER_ID.
# APPLE_VENDOR_NUMBER=

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
# "stdio" (default) — standard MCP transport, no network socket is opened.
# "http"            — optional Streamable HTTP server, see the guardrails below.
TRANSPORT=stdio

# LOG_LEVEL: debug | info | warn | error | silent (default: info).
# All logs go to stderr; stdout is reserved for the MCP protocol.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# HTTP transport — only read when TRANSPORT=http
# ---------------------------------------------------------------------------
PORT=3001

# Loopback by default. Binding a non-loopback address (e.g. 0.0.0.0) REQUIRES
# authentication: either OAUTH_ENABLED=true or MCP_HTTP_TOKEN. The server
# refuses to start otherwise — this endpoint has full App Store Connect access.
HOST=127.0.0.1

# Defaults to the server's own origin. Do not use "*" on a non-loopback host.
CORS_ORIGIN=http://127.0.0.1:3001

# Shared bearer token required on every MCP request when OAuth is disabled.
# Generate with: openssl rand -hex 32
# MCP_HTTP_TOKEN=

# ---------------------------------------------------------------------------
# OAuth (optional, HTTP transport only)
# ---------------------------------------------------------------------------
OAUTH_ENABLED=false
# STYTCH_PROJECT_DOMAIN=https://your-domain.stytch.com
# STYTCH_PROJECT_ID=your_project_id
# STYTCH_JWKS_URI=https://your-domain.stytch.com/.well-known/jwks.json
